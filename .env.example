# Copier ce fichier en `.env` sur chaque machine (jamais commité — cf. .gitignore)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle de l'AGENT.
#   claude-haiku-4-5  → RETENU par l'arbitrage voix du 25/08. Latence d'un tour du
#                       contrôleur : 1,93 s de médiane, contre 3,42 s en Sonnet 5 —
#                       hors STT et TTS, pour un budget conversationnel de 0,5 à 1 s.
#                       Validé 42/42 sur les 14 personas d'éval.
#   claude-sonnet-5   → plus lent, sans gain mesuré sur les évals depuis les correctifs
#                       du 25/08. Ne pas l'utiliser pour le spike vocal.
#
# ⚠️ Cette variable ÉCRASE le défaut du code (déjà claude-haiku-4-5) : la laisser sur
# Sonnet ferait tourner le spike en Sonnet sans que rien ne le signale. Pour comparer
# deux modèles sans toucher au .env : `python run_llm_eval.py --modele <id>`.
RELAIS_MODEL=claude-haiku-4-5


# ---------------------------------------------------------------------------
# Postgres (Supabase, région UE — spec §9). Dashboard → « Connect ».
# Renseigner les DEUX : run_depot_pg.py essaie la directe, puis bascule sur le
# pooler si elle échoue (l'hôte direct est en IPv6 sur les projets récents, et
# un réseau IPv4 seul ne peut pas l'atteindre).
#
# ⚠️  run_depot_pg.py TRONQUE les tables. Sa garde n'est pas le nom de ces
# variables — toutes les bases Supabase s'appellent « postgres », un contrôle par
# nom ne se déclencherait jamais. C'est un marqueur écrit DANS la base, posé une
# fois par `--autoriser-truncate`. Ne le pose jamais sur la base de production.
# ---------------------------------------------------------------------------

# Connexion directe — db.<ref>.supabase.co:5432
DATABASE_URL=postgresql://postgres:motdepasse@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Session pooler — ...pooler.supabase.com:5432 (repli IPv4 ; noter le user postgres.<ref>)
DATABASE_URL_POOLER=postgresql://postgres.<ref>:motdepasse@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Secret partage avec la plateforme vocale (porte webhook de l'API).
# DISTINCT des tokens artisans : l'appelant du webhook est la plateforme, pas
# l'artisan — celui-ci est identifie par le numero Relais appele.
RELAIS_WEBHOOK_SECRET=change-moi

# Racine publique des liens de validation client envoyes par SMS
# (remplace le " Repondez OUI " : sender alphanumerique = unidirectionnel).
# Exigee au demarrage : un lien pointant sur un mauvais domaine est mort chez le
# client sans provoquer la moindre erreur cote serveur.
RELAIS_BASE_URL=https://relais.example

# OVH SMS — uniquement pour l'envoi REEL (rien n'en depend en mock).
# Creer le consumer key avec des droits MINIMAUX : POST /sms/* et une expiration,
# jamais /* ni GET /me/*. Le SDK ovh lit ces trois variables directement.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Nom du service SMS, visible dans l'espace client OVH (Telecom > SMS) ou via
# `python envoyer_un_sms.py --comptes`. Forme reelle : sms-xy12345-1
OVH_SMS_COMPTE=<remplace-moi-par-ton-service-sms>

# Mode d'envoi des SMS par worker.py. Defaut inoffensif : un cron mal configure
# ne doit pas se mettre a ecrire a de vrais clients.
#   journal (defaut) : rien ne part, tout est journalise
#   ovh              : envoi REEL (exige les OVH_* ci-dessus)
RELAIS_SMS=journal
# Envoi par numero court : aucune declaration d'expediteur requise, MAIS les URL y
# sont bloquees -> les SMS de reproposition echoueront (visiblement). Mode de
# transition en attendant la validation du Sender ID.
# RELAIS_SMS_NUMERO_COURT=1

# ---------------------------------------------------------------------------
# VAPI — plateforme vocale retenue pour le SPIKE (arbitrage du 25/08).
#
# ⚠️ AUCUN CODE NE LIT ENCORE CETTE VARIABLE. L'adaptateur n'existe pas : il attend
# l'etape 0 du spike, qui consiste a journaliser la charge utile brute du premier
# appel reel — on ne sait pas encore si elle porte un identifiant d'appel, et les
# deux montages qui en decoulent sont trop differents pour parier. La cle est ici
# pour etre au bon endroit le jour ou l'adaptateur la lira.
#
# Cle PRIVEE (portee « private »), pas la cle publique du SDK web : c'est elle qui
# authentifie les appels serveur vers https://api.vapi.ai, en `Authorization: Bearer`.
# Tableau de bord Vapi > API Keys. Elle n'est necessaire que pour piloter Vapi par
# l'API (creer l'assistant, attacher le numero) — tout cela se fait aussi a la main
# dans leur interface.
VAPI_API_KEY=

# Dans l'AUTRE SENS — Vapi appelant notre serveur — aucun secret supplementaire n'est
# necessaire : Vapi sait poser un en-tete personnalise sur l'URL du custom LLM. On lui
# fait donc envoyer `X-Relais-Secret` avec la valeur de RELAIS_WEBHOOK_SECRET ci-dessus,
# qui est litteralement decrit comme « le secret partage avec la plateforme vocale ».
# C'est son cas d'usage, il n'attendait que ca.
# ---------------------------------------------------------------------------

# Attribut Secure du cookie de session artisan. Defaut : true.
#
#   false = TESTS HTTP LOCAUX UNIQUEMENT, jamais en production.
#
# Un cookie Secure est jete par le navigateur en HTTP. « localhost » est une
# exception chez Chrome, MAIS PAS une IP de reseau local : en testant depuis un
# telephone sur http://192.168.x.x:8000, la connexion boucle sur le formulaire.
# Seul le mot exact « false » desactive l'attribut — une faute de frappe laisse le
# cookie en Secure, pour que la production ne puisse pas regresser par etourderie.
RELAIS_COOKIE_SECURE=true

