# Copier ce fichier en `.env` sur chaque machine (jamais commité — cf. .gitignore)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé par le prototype
#   claude-sonnet-5   → qualité conversationnelle max (phase de test/éval)
#   claude-haiku-4-5  → rapide et peu coûteux (cible prod pour la latence téléphonique)
RELAIS_MODEL=claude-sonnet-5

# Base de TEST pour run_depot_pg.py — Postgres managé, région UE (spec §9).
# Volontairement distincte de DATABASE_URL : le lanceur de tests TRONQUE les tables,
# deux variables séparées rendent l'accident impossible plutôt qu'improbable.
DATABASE_URL_TEST=postgresql://user:motdepasse@host/dbname?sslmode=require
# DATABASE_URL=   (production, plus tard — jamais tronquée par les tests)
