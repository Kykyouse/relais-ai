# Copier ce fichier en `.env` sur chaque machine (jamais commité — cf. .gitignore)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé par le prototype
#   claude-sonnet-5   → qualité conversationnelle max (phase de test/éval)
#   claude-haiku-4-5  → rapide et peu coûteux (cible prod pour la latence téléphonique)
RELAIS_MODEL=claude-sonnet-5


# ---------------------------------------------------------------------------
# Postgres (Supabase, région UE — spec §9). Dashboard → « Connect ».
# Renseigner les DEUX : run_depot_pg.py essaie la directe, puis bascule sur le
# pooler si elle échoue (l'hôte direct est en IPv6 sur les projets récents, et
# un réseau IPv4 seul ne peut pas l'atteindre).
#
# ⚠️  run_depot_pg.py TRONQUE les tables. Sa garde n'est pas le nom de ces
# variables — toutes les bases Supabase s'appellent « postgres », un contrôle par
# nom ne se déclencherait jamais. C'est un marqueur écrit DANS la base, posé une
# fois par `--autoriser-truncate`. Ne le pose jamais sur la base de production.
# ---------------------------------------------------------------------------

# Connexion directe — db.<ref>.supabase.co:5432
DATABASE_URL=postgresql://postgres:motdepasse@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Session pooler — ...pooler.supabase.com:5432 (repli IPv4 ; noter le user postgres.<ref>)
DATABASE_URL_POOLER=postgresql://postgres.<ref>:motdepasse@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Secret partage avec la plateforme vocale (porte webhook de l'API).
# DISTINCT des tokens artisans : l'appelant du webhook est la plateforme, pas
# l'artisan — celui-ci est identifie par le numero Relais appele.
RELAIS_WEBHOOK_SECRET=change-moi

# Racine publique des liens de validation client envoyes par SMS
# (remplace le " Repondez OUI " : sender alphanumerique = unidirectionnel).
# Exigee au demarrage : un lien pointant sur un mauvais domaine est mort chez le
# client sans provoquer la moindre erreur cote serveur.
RELAIS_BASE_URL=https://relais.example

# OVH SMS — uniquement pour l'envoi REEL (rien n'en depend en mock).
# Creer le consumer key avec des droits MINIMAUX : POST /sms/* et une expiration,
# jamais /* ni GET /me/*. Le SDK ovh lit ces trois variables directement.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Nom du service SMS, visible dans l'espace client OVH (Telecom > SMS) ou via
# `python envoyer_un_sms.py --comptes`. Forme reelle : sms-xy12345-1
OVH_SMS_COMPTE=<remplace-moi-par-ton-service-sms>

# Mode d'envoi des SMS par worker.py. Defaut inoffensif : un cron mal configure
# ne doit pas se mettre a ecrire a de vrais clients.
#   journal (defaut) : rien ne part, tout est journalise
#   ovh              : envoi REEL (exige les OVH_* ci-dessus)
RELAIS_SMS=journal
# Envoi par numero court : aucune declaration d'expediteur requise, MAIS les URL y
# sont bloquees -> les SMS de reproposition echoueront (visiblement). Mode de
# transition en attendant la validation du Sender ID.
# RELAIS_SMS_NUMERO_COURT=1

